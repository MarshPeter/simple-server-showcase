# Copy to .env and fill in. Never commit .env.

# Neon: Dashboard -> Connect -> pooled connection string (keep sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Teacher-only board wipe: curl -X POST -H "X-Reset-Token: ..." https://<app>/api/reset
# Leave empty to disable the endpoint.
RESET_TOKEN=

# Safety cap so a room of students can't fill the database.
MAX_TODOS=200
